              "type": "argument",
              "parser": "minecraft:block_state",
              "executable": true,
              "children": {
                "destroy": { "type": "literal", "executable": true },
                "keep": { "type": "literal", "executable": true },
                "replace": { "type": "literal", "executable": true }
              }
            }
          }
        }
      }
    },
    "summon": {
