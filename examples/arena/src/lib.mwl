// The whole language in one datapack.
//
// Every tick this looks at the zombies nearby, seals the first few of them under a
// block, works out how bad things are, and reacts. It uses the pieces the other
// examples show one at a time: `struct` and `enum` in storage, `match`, `Vec`,
// `impl` with borrowed receivers, execution contexts, and real commands from the
// toolchain in `../toolchains/1.21.4`.
//
// Two things are worth watching in the output (`target/datapack`):
//
// - `arena:tally/note_tick_seen` and friends. A borrowed parameter is compiled once
//   per place it is called on, so `seen.note()` writes straight into the caller's
//   compound. No arguments are marshalled, and no commands are spent on the call
//   beyond the call itself.
// - `arena:tick/for_0`. The `for` body is one function, run once per entity by a
//   single `execute as`. What it costs is one function call per zombie, not one per
//   zombie per statement.

/// How crowded the arena is. A tagged compound in storage: `{tag:"Rising",seen:3}`.
enum Threat {
    Calm,
    Rising { seen: i32 },
    Swarm,
}

/// What this tick found. The tags matter: vanilla treats `Byte(1)` and `Int(1)` as
/// different values, and ignores data written with the wrong one without a word.
struct Tally {
    #[nbt(short)]
    seen: i32,
    #[nbt(byte)]
    sealed: i32,
    #[nbt(rename = "Alerted")]
    alerted: bool,
}

impl Tally {
    /// `&mut self` borrows the caller's compound; nothing is copied back.
    fn note(&mut self) {
        self.seen += 1;
    }

    fn sealed_one(&mut self) {
        self.sealed += 1;
    }

    fn quiet(&self) -> bool {
        return self.seen == 0;
    }
}

/// A struct cannot be returned — vanilla's function return is a single number — so the
/// answer comes back through a `&mut` parameter. That is what compile-time references
/// are for: the write lands directly in the caller's storage.
fn classify(tally: &Tally, out: &mut Threat) {
    if tally.quiet() {
        out = Threat::Calm;
        return;
    }
    if tally.seen >= 6 {
        out = Threat::Swarm;
        return;
    }
    out = Threat::Rising { seen: tally.seen };
}

/// The arena itself, written the way vanilla writes it: a `Double` radius and a
/// string. `nbt!` is checked against this type, so a key that is not a field here is
/// a compile error rather than data Minecraft quietly ignores.
struct Arena {
    #[nbt(rename = "Radius")]
    radius: f64,
    name: String,
}

/// Roughly `pi * r * r`, in thousandths.
///
/// `fix<1000>` is an integer on the scoreboard whose type says what it counts. The
/// scale correction on `*` is inserted by the compiler; mixing `fix<100>` with
/// `fix<1000>` would not compile.
fn area(r: fix<1000>) -> fix<1000> {
    let pi = fix::<1000>(3142);
    return pi * r * r;
}

/// Generic, and monomorphised per element type: `total_i32` is the only instance this
/// pack contains, because it is the only one anything asks for.
fn total<T>(v: Vec<T>) -> i32 {
    return v.len();
}

/// A window onto an entity's NBT. Not a value: the fields are paths on whatever the
/// selector found, and making one costs no commands at all.
///
/// The declaration is where the mistakes get caught. `Health` is a `Float` holding the
/// real number, so reading it into a `fix<1000>` is `data get entity @s Health 1000` —
/// written once here rather than at every use.
#[entity]
struct Mob {
    #[nbt(float, rename = "Health")]
    hp: Option<fix<1000>>,
    #[nbt(byte, rename = "Glowing")]
    glowing: Option<i32>,
}

/// `#[ctx(entity)]` says this needs an executor. Calling it without one is a compile
/// error — in vanilla it would run, do nothing, and say nothing.
#[ctx(entity)]
fn seal() {
    // `~ ~2 ~` is relative to the position the caller is `at`, and is known while
    // compiling, so it costs nothing to pass.
    setblock(pos!(~ ~2 ~), minecraft:stone);

    let mut m = Mob::of(@s);
    m.glowing = Some(1);
    // A key vanilla never wrote reads as `None`; there is nothing to test for it
    // beyond asking whether the path is there.
    if let Some(hp) = m.hp {
        if hp < fix::<1000>(5000) {
            play_sound(minecraft:block.note_block.pling, @a);
        }
    }
}

#[tick]
fn tick() {
    let mut seen = Tally {
        seen: 0,
        sealed: 0,
        alerted: false,
    };

    // One `execute as` for the whole block: the body is a function, run once per
    // entity the selector finds. The position does not move with it — `at @s` is
    // written where it is wanted, never implied.
    for z in @e[type=zombie, distance=..12] {
        seen.note();

        if seen.sealed >= 3 {
            continue;
        }
        at @s {
            seal();
        }
        seen.sealed_one();
    }

    let mut threat = Threat::Calm;
    classify(&seen, &mut threat);

    // Exactly one arm runs: the compiler copies the value aside before testing, so an
    // arm that moves the state on cannot make the arm below it run as well.
    match threat {
        Threat::Calm => {}
        Threat::Rising { seen } => {
            if seen >= 3 {
                play_sound(minecraft:block.note_block.pling, @a);
            }
        }
        Threat::Swarm => {
            play_sound(minecraft:entity.wither.spawn, @a);
            // `text!` writes the JSON, including the fake player name the score lives
            // under. Nothing here costs a command: the component names the score, it
            // does not read it.
            let count = seen.seen;
            tellraw(
                @a,
                text!("the arena is swarming".red().bold(), " (", count, " of them)"),
            );
        }
    }
}

#[load]
fn setup() {
    // A list literal is one `data modify ... set value`, whatever its length.
    let rewards = [1, 2, 3];
    let count = total(rewards);
    if count == 3 {
        say("arena online");
    }

    // The compound is written once, whole. Reading `Radius` into a `fix<1000>` is
    // one `data get ... 1000`: storage keeps the real number, the scoreboard keeps
    // thousandths of it.
    let arena: Arena = nbt!({ Radius: 8, name: "pit" });
    let size = area(fix::<1000>(arena.radius));
    if size > fix::<1000>(200000) {
        say("a big arena");
    }
    // Comparing against a literal is one `execute if data`: no macro, no copy.
    if arena.name == "pit" {
        say("the pit is open");
    }
}
